cat > .gitignore << 'EOF'
# ===== Dependencias =====
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== Build / salida compilada =====
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# ===== Variables de entorno (secretos) =====
.env
.env.*
!.env.example

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Testing / cobertura =====
coverage/
.nyc_output/
junit.xml

# ===== Cachés de herramientas =====
.eslintcache
.stylelintcache
.npm/
.node_repl_history
*.tgz

# ===== Archivos de proceso =====
pids/
*.pid
*.seed
*.pid.lock

# ===== NestJS =====
/dist
/uploads
/temp

# ===== Docker =====
docker-compose.override.yml

# ===== Editores / IDEs =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ===== Sistema operativo =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== Varios =====
*.local
.vercel
.firebase/
.serverless/
EOF